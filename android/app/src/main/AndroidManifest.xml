<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lo único que pide la app es internet: el micrófono lo pide Chrome, como en la web. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Para encontrar Chrome y los navegadores que abren una TWA (Android 11 o más nuevo). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/nombre"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <!-- Lo que vincula la app con la web: Chrome lo compara con /.well-known/assetlinks.json. -->
        <meta-data android:name="asset_statements" android:resource="@string/assetStatements" />

        <activity
            android:name=".Lanzador"
            android:exported="true"
            android:label="@string/nombre"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="@string/direccion" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:resource="@color/fondo" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:resource="@color/fondo" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE" android:resource="@drawable/splash" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR" android:resource="@color/fondo" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION" android:value="300" />
            <meta-data android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY" android:value="@string/proveedor" />
            <meta-data android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION" android:value="portrait" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Con la app instalada, un link del simulador (el de la clase, mandado por
                 WhatsApp) se abre en la app y no en el navegador de adentro de WhatsApp. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="simulador.kalulab.store" />
            </intent-filter>
        </activity>

        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />
        <activity
            android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:configChanges="orientation|screenSize" />

        <!-- Por acá se le pasa a Chrome la imagen de la pantalla de inicio. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@string/proveedor"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/rutas" />
        </provider>
    </application>
</manifest>
