{
  "functions": {
    "api/chat.js": { "maxDuration": 60 },
    "api/datos.js": { "maxDuration": 20 }
  },
  "crons": [
    { "path": "/api/datos?vivo=1", "schedule": "0 15 * * *" }
  ],
  "redirects": [
    { "source": "/kalulab/:ruta*", "destination": "https://www.kalulab.store/:ruta*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/panel", "destination": "/panel.html" },
    { "source": "/instructores", "destination": "/instructores.html" },
    { "source": "/fundamentos", "destination": "/fundamentos.html" },
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/activar", "destination": "/activar.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=()" }
      ]
    }
  ]
}
